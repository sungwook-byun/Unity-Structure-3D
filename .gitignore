# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#

.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
*.log
.idea/

# Blender files not needed for version control
*.blend1
*.blend1.meta

# MemoryCaptures (very large and sensitive data)
[Mm]emoryCaptures/

# Unity Recorder Recordings (large files)
[Rr]ecordings/

# Uncomment this to ignore Asset Store Tools plugin if used
# /[Aa]ssets/AssetStoreTools*

# JetBrains Rider IDE autogenerated files
/[Aa]ssets/Plugins/Editor/JetBrains*
*.DotSettings.user

# Visual Studio cache and config files
.vs/

# Gradle cache directory
.gradle/

# Auto-generated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity meta and crash files
*.pidb.meta
*.pdb.meta
*.mdb.meta
sysinfo.txt
mono_crash.*

# Build outputs (ignore binary builds, packages)
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# TestRunner auto-generated test scenes
InitTestScene*.unity*

# Addressables default ignore patterns
/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting auto-generated files
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Auto-generated scenes by play mode tests
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# Common OS files
.DS_Store
Thumbs.db

# VS Code settings folder
.vscode/

# Optional: User specific or large files you want to ignore specifically, for example:
# Assets/3. Unity Book/99. Resources/3D FPS Shooter/Easy FPS/Model_Animations_Textures/main character/Textures/Sword_*.tif

